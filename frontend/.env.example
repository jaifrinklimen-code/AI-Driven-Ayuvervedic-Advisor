# Frontend Environment Variables
# Copy to frontend/.env for local development or set in your Vercel Project Settings for production

# Backend API Base URL
# In development, leave empty or set to http://localhost:8000
# In production (e.g. deployed on Vercel), set to your deployed backend service URL (e.g. Render, Railway, AWS ECS)
VITE_BACKEND_URL=http://localhost:8000

# Supabase Configuration (Optional - for persistent analytics & query history)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
