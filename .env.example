# IP-SAKTI Sahayak Environment Configuration
# Copy this file to .env and provide your API keys if using external providers.
# Offline / Local Demo Mode works automatically without any external API keys!

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# LLM Providers (Optional - fallback to built-in grounded legal engine if not provided)
GEMINI_API_KEY=
OPENAI_API_KEY=
HUGGINGFACEHUB_API_TOKEN=

# Model Preferences
LLM_PROVIDER=offline_demo  # Options: offline_demo | gemini | openai | huggingface
DEFAULT_MODEL=gemini-1.5-flash

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
